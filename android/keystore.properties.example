# Copy to android/keystore.properties and fill in. Create the key first with:
#   keytool -genkeypair -v -keystore heimat-upload.jks -alias heimat \
#     -keyalg RSA -keysize 2048 -validity 10000
# Keep heimat-upload.jks somewhere safe and backed up: losing it means you can
# never update the Play listing again.
storeFile=../heimat-upload.jks
storePassword=
keyAlias=heimat
keyPassword=
