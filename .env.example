VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Public half of the VAPID pair used for web push. Safe to expose — the private
# half lives server-side in the app_config table and is read only by the push
# edge function. Generate a pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# Public web address of Heimat. The native shells use it for invite links,
# because inside them location.origin is capacitor://localhost.
VITE_PUBLIC_URL=https://meet-p-dev.github.io/Heimat/
# Where the emailed password-reset link comes back to. Defaults to reset.html
# inside VITE_PUBLIC_URL, which is right as long as Heimat lives on the shared
# GitHub Pages origin. Set it outright once Heimat has a domain of its own, and
# add the new address to Supabase → Authentication → URL Configuration →
# Redirect URLs. See docs/password-reset.md.
# VITE_RESET_URL=https://meet-p-dev.github.io/Heimat/reset.html
